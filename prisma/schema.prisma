// ============================================================================
// Import Comparison Platform — Database Schema
// Phase 1: Database Schema
//
// Design principles (per project requirements):
// - Raw ingestion data is NEVER overwritten — it's an append-only audit trail.
// - Canonical/matched records are derived, reviewable, and never auto-guessed
//   when confidence is low (NEEDS_REVIEW exists for a reason — use it).
// - Price/freight snapshots exist so Redis cache TTLs have a durable backstop
//   and so "landed cost at time X" is always reconstructable for support/audit.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum LocalSourceType {
  JUMIA_SCRAPE
  JUMIA_SELLER_API
  MANUAL_CSV
  SUPPLIER_FEED
  OWN_DB
}

enum MatchStatus {
  UNMATCHED // no candidate AliExpress SKU identified yet
  AUTO_MATCHED // matched by the system on strong signals (e.g. exact GTIN/barcode)
  NEEDS_REVIEW // ambiguous — multiple candidates or weak signal match; human must confirm
  MANUAL_CONFIRMED // a human explicitly confirmed this match
  REJECTED // a human explicitly reviewed and rejected this candidate match
}

enum ComparisonRenderMode {
  IMPORT_ADVANTAGE // Landed Import Price < Local Total Price -> show 2-column comparison
  LOCAL_ONLY // Landed Import Price >= Local Total Price -> suppress comparison, show local only
}

enum CategorySourceType {
  ALIEXPRESS
  JUMIA
}

// ----------------------------------------------------------------------------
// Categories — hierarchical canonical taxonomy + a crosswalk mapping each
// source platform's own category system onto it.
//
// Products are assigned to this controlled canonical taxonomy automatically
// when strong title/spec/source-category evidence exists. Source-specific
// category mappings are retained so reviewed mappings remain authoritative.
//
// Why this exists: category is a hard GATE for matching, not just a signal.
// Two products should only be considered for SKU matching (or shown as
// "similar/alternative") if they resolve to the same canonical Category —
// this is what prevents e.g. "Nike sport shoes" from being matched or
// compared against "Nike" products that aren't shoes at all. Brand is a
// separate attribute (see LocalSKU/AliExpressSKU specs/title) that can
// strengthen a match WITHIN a category, but should never substitute for a
// category match.
// ----------------------------------------------------------------------------

model Category {
  id       String    @id @default(cuid())
  name     String // canonical name, e.g. "Sport Shoes" — TBD once real data exists
  parentId String?
  parent   Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")

  localSkus      LocalSKU[]
  aliExpressSkus AliExpressSKU[]
  mappings       CategoryMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// The crosswalk: each row links ONE source platform's own category
// identifier to ONE canonical Category. E.g. AliExpress category id
// "200003482" and Jumia category slug "sports-shoes-men" might both map to
// the same canonical Category("Sport Shoes").
model CategoryMapping {
  id         String             @id @default(cuid())
  categoryId String
  category   Category           @relation(fields: [categoryId], references: [id])

  source             CategorySourceType
  sourceCategoryId   String // raw category id/slug exactly as the platform provides it
  sourceCategoryName String? // raw label, kept for human debugging/audit — not used for matching

  createdAt DateTime @default(now())

  @@unique([source, sourceCategoryId])
  @@index([categoryId])
}

// ----------------------------------------------------------------------------
// Local side — raw ingestion layer (append-only, one row per ingestion event)
// ----------------------------------------------------------------------------

model LocalListingRaw {
  id        String          @id @default(cuid())
  source    LocalSourceType
  sourceRef String // source-specific identifier (Jumia SKU id, CSV row ref, supplier SKU code, etc.)

  // Data exactly as received — no normalization, no overwriting on re-ingest.
  title       String
  description String? @db.Text
  imageUrls   String[] // raw image URLs as received from the source
  sourceUrl   String? // original product/listing URL exactly as received
  priceRaw    Decimal  @db.Decimal(12, 2)
  currency    String   @default("KES")
  inStock     Boolean?
  attributesRaw Json? // color/size/spec fields as received, unnormalized

  ingestedAt DateTime @default(now())

  // Optional link once this raw listing has been resolved into a canonical SKU.
  // Nullable because a raw listing may sit unmatched/unreviewed for a while.
  localSkuId String?
  localSku   LocalSKU? @relation(fields: [localSkuId], references: [id])

  @@index([source, sourceRef])
  @@index([localSkuId])
  @@index([ingestedAt])
}

// ----------------------------------------------------------------------------
// Local side — canonical record used in comparisons
// ----------------------------------------------------------------------------

model LocalSKU {
  id          String  @id @default(cuid())
  sku         String  @unique // internal canonical SKU code
  title       String
  description String? @db.Text
  imageUrls   String[]
  sourceUrl   String? // original product/listing URL carried from ingestion

  // Variant-level precision fields — matching happens strictly at this level.
  color String?
  size  String?
  specs Json? // normalized spec attributes for variant matching

  currentPrice Decimal  @db.Decimal(12, 2)
  currency     String   @default("KES")
  inStock      Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  // Homepage "featured" control: null (default) means "use automatic logic"
  // (currently: feature if this product has a confirmed IMPORT_ADVANTAGE
  // comparison). true forces it featured regardless; false forces it
  // excluded even if it would otherwise qualify. Edit directly in Prisma
  // Studio — no dedicated admin UI for this yet, per explicit decision to
  // keep this low-effort until a real need for one arises.
  featuredOverride Boolean?

  // Category assignment is automatic when evidence is strong; null means the
  // classifier could not establish a safe category and matching/relationship
  // logic must not guess across that boundary.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  rawListings LocalListingRaw[]
  matches     SKUMatch[]
  priceHistory LocalPriceSnapshot[]

  @@index([color, size])
  @@index([categoryId])
}

model LocalPriceSnapshot {
  id         String   @id @default(cuid())
  localSkuId String
  localSku   LocalSKU @relation(fields: [localSkuId], references: [id])
  price      Decimal  @db.Decimal(12, 2)
  inStock    Boolean
  recordedAt DateTime @default(now())

  @@index([localSkuId, recordedAt])
}

// ----------------------------------------------------------------------------
// AliExpress side — canonical record, backed by Redis cache but persisted
// here as the durable source (Redis TTL expiry should never mean data loss).
// ----------------------------------------------------------------------------

model AliExpressSKU {
  id           String  @id @default(cuid())
  productId    String // AliExpress product id
  skuId        String // AliExpress SKU-level id (variant)
  title        String
  description  String? @db.Text
  imageUrls    String[]

  color String?
  size  String?
  specs Json?

  // skuPrice is the API's Origin SKU price; offerSalePrice is the API's
  // promotional/offer price. itemPrice remains the effective price used by
  // the existing comparison engine and defaults to offerSalePrice when present.
  skuPrice       Decimal @db.Decimal(12, 2)
  offerSalePrice Decimal @db.Decimal(12, 2)
  itemPrice      Decimal @db.Decimal(12, 2)
  currency       String  @default("USD")
  priceIncludeTax Boolean @default(false)
  skuCode        String?
  availableStock Int     @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // Explicit publish control: false by default. An AliExpress SKU only
  // becomes a real, browsable/sellable product on the storefront once
  // this is flipped to true — nothing goes live automatically just
  // because it's been fetched (e.g. during testing or matching). Same
  // low-effort pattern as LocalSKU.featuredOverride: edit directly in
  // Prisma Studio for now, no dedicated admin UI yet.
  isPublished Boolean @default(false)

  // See LocalSKU.categoryId comment — null means the product remains outside
  // category-gated comparison/related-product logic until classified safely.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  rawCategoryId String?
  shipFromCountry String?

  // Exact AliExpress source category. This is separate from the internal
  // canonical matching category so storefront labels remain supplier-native.
  aliExpressCategoryId String?
  aliExpressCategory   AliExpressCategory? @relation(fields: [aliExpressCategoryId], references: [id])

  matches         SKUMatch[]
  freightQuotes   FreightSnapshot[]
  priceHistory    AliExpressPriceSnapshot[]
  importListingPrice ImportListingPrice?

  @@unique([productId, skuId])
  @@index([productId])
  @@index([categoryId])
  @@index([aliExpressCategoryId])
}

model AliExpressCategory {
  id         String  @id @default(cuid())
  categoryId String  @unique
  name       String
  names      Json?
  level      Int?
  isLeaf     Boolean @default(false)

  parentId String?
  parent   AliExpressCategory?  @relation("AliExpressCategoryHierarchy", fields: [parentId], references: [id])
  children AliExpressCategory[] @relation("AliExpressCategoryHierarchy")
  skus     AliExpressSKU[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([name])
}

model AliExpressPriceSnapshot {
  id              String        @id @default(cuid())
  aliExpressSkuId String
  aliExpressSku   AliExpressSKU @relation(fields: [aliExpressSkuId], references: [id])
  itemPrice       Decimal       @db.Decimal(12, 2)
  recordedAt      DateTime      @default(now())

  @@index([aliExpressSkuId, recordedAt])
}

// Freight rates change independently of product price and have their own
// TTL (6-12h) per the caching spec — kept as a separate snapshot table.
model FreightSnapshot {
  id              String        @id @default(cuid())
  aliExpressSkuId String
  aliExpressSku   AliExpressSKU @relation(fields: [aliExpressSkuId], references: [id])
  destination     String // shipping destination code/region used for the quote
  freightCost     Decimal       @db.Decimal(12, 2)
  estimatedTaxes  Decimal       @db.Decimal(12, 2)
  currency        String        @default("USD")
  etaMinDays      Int
  etaMaxDays      Int
  recordedAt      DateTime      @default(now())
  expiresAt       DateTime // mirrors the Redis TTL so stale rows are identifiable in Postgres too

  @@index([aliExpressSkuId, destination, recordedAt])
}

// ----------------------------------------------------------------------------
// Matching — links a local SKU to its AliExpress counterpart.
// Deliberately conservative: ambiguous matches are flagged, never guessed.
//
// IMPORTANT for the matching engine (Phase 3): category match is a hard
// precondition, not a scored signal. Never create a SKUMatch (even
// NEEDS_REVIEW) across two SKUs whose categoryId doesn't resolve to the
// same canonical Category. Brand/title/spec similarity only apply to
// narrow down candidates WITHIN a shared category.
// ----------------------------------------------------------------------------

model SKUMatch {
  id String @id @default(cuid())

  localSkuId      String
  localSku        LocalSKU      @relation(fields: [localSkuId], references: [id])
  aliExpressSkuId String
  aliExpressSku   AliExpressSKU @relation(fields: [aliExpressSkuId], references: [id])

  status         MatchStatus @default(UNMATCHED)
  matchSignal    String? // what triggered the match, e.g. "exact_gtin", "title_similarity_0.92"
  confidenceNote String? // human-readable note, esp. for NEEDS_REVIEW / REJECTED

  reviewedBy String? // user/admin identifier who confirmed or rejected, if applicable
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The resolved comparison, computed and cached once the match is confirmed.
  comparison ComparisonResult?

  @@unique([localSkuId, aliExpressSkuId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// The actual landed-cost comparison result — this is what the UI reads.
// Recomputed whenever underlying price/freight snapshots change; stored so
// the render decision (2-column vs local-only) doesn't need recomputation
// on every page load.
// ----------------------------------------------------------------------------

model ComparisonResult {
  id         String   @id @default(cuid())
  skuMatchId String   @unique
  skuMatch   SKUMatch @relation(fields: [skuMatchId], references: [id])

  landedImportPrice Decimal              @db.Decimal(12, 2) // true cost, before markup
  sellPrice         Decimal              @db.Decimal(12, 2) // landedImportPrice + tiered markup — what the customer actually pays
  localTotalPrice   Decimal              @db.Decimal(12, 2)
  renderMode        ComparisonRenderMode
  currency          String               @default("KES")

  // Staleness tracking: when the underlying price data actually last refreshed
  // (not when this row was computed), and whether it came from a live cache
  // hit or a fallback to the last known snapshot after an AliExpress failure.
  priceDataAsOf DateTime
  isStale       Boolean  @default(false)

  computedAt DateTime @default(now())

  @@index([renderMode])
}

// Cached sell price for a STANDALONE AliExpress product — one with no local
// match at all. Same role as ComparisonResult (avoids recomputing live on
// every listing/page view) but for products with nothing to compare
// against. One row per AliExpressSKU.
model ImportListingPrice {
  id              String        @id @default(cuid())
  aliExpressSkuId String        @unique
  aliExpressSku   AliExpressSKU @relation(fields: [aliExpressSkuId], references: [id])

  landedImportPrice Decimal @db.Decimal(12, 2) // true cost, before markup
  sellPrice         Decimal @db.Decimal(12, 2) // landedImportPrice + tiered markup
  markup            Decimal @db.Decimal(12, 2)
  currency          String  @default("KES")
  freeShipping      Boolean @default(true)

  priceDataAsOf DateTime
  isStale       Boolean  @default(false)
  computedAt    DateTime @default(now())
}

// Durable backstop for exchange rates, same pattern as AliExpressPriceSnapshot —
// so a Redis cache miss + API outage still has a last-known rate to fall back on.
enum ImportOrderStatus {
  PAYMENT_PENDING
  PAID
  SUBMITTING
  SUBMITTED
  FAILED
  CANCELLED
}

enum ImportPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

enum PaymentProvider {
  DARAJA
  PAYSTACK
}

model ImportOrder {
  id               String            @id @default(cuid())
  outOrderId       String            @unique
  status           ImportOrderStatus @default(PAYMENT_PENDING)
  country          String
  province         String
  city             String
  address          String
  address2         String?
  fullName         String?
  email            String?
  mobileNo         String?
  zip              String?
  currency         String            @default("KES")
  customerTotal    Decimal           @db.Decimal(12, 2)
  supplierOrderIds String[]          @default([])
  errorMessage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  payment          ImportPayment?
  items            ImportOrderItem[]
  shipments        ImportShipment[]
  @@index([status, createdAt])
}

model ImportPayment {
  id                String              @id @default(cuid())
  orderId           String              @unique
  order             ImportOrder        @relation(fields: [orderId], references: [id])
  provider          PaymentProvider     @default(DARAJA)
  status            ImportPaymentStatus @default(PENDING)
  checkoutRequestId String?             @unique
  providerReference String?             @unique
  merchantRequestId String?
  mpesaReceiptNumber String?
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("KES")
  paidAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status, createdAt])
}

model ImportOrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           ImportOrder     @relation(fields: [orderId], references: [id])
  aliExpressSkuId String?
  localSkuId      String?
  productId       String
  skuId           String
  quantity        Int
  unitSellPrice   Decimal         @db.Decimal(12, 2)
  createdAt       DateTime        @default(now())
  @@index([orderId])
  @@index([aliExpressSkuId])
  @@index([localSkuId])
  @@index([productId, skuId])
}

enum ImportShipmentStatus {
  PENDING
  LABEL_CREATED
  IN_TRANSIT
  ARRIVED_DESTINATION
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
  UNKNOWN
}

model ImportShipment {
  id                    String               @id @default(cuid())
  orderId               String
  order                 ImportOrder          @relation(fields: [orderId], references: [id])
  supplierOrderId       String
  carrier               String?
  trackingNumber        String?
  shippingMethod        String?
  currentStatus         ImportShipmentStatus @default(PENDING)
  currentRawStatus      String?
  estimatedDeliveryStart DateTime?
  estimatedDeliveryEnd   DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  events                ImportShipmentEvent[]

  @@index([orderId])
  @@index([supplierOrderId])
  @@index([trackingNumber])
  @@index([currentStatus, lastSyncedAt])
}

model ImportShipmentEvent {
  id           String               @id @default(cuid())
  shipmentId   String
  shipment     ImportShipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status       ImportShipmentStatus
  rawStatus    String?
  description  String?
  location     String?
  eventDate    DateTime
  externalKey  String               @unique
  raw          Json?
  createdAt    DateTime             @default(now())

  @@index([shipmentId, eventDate])
}

model HomepageHero {
  id        String   @id @default(cuid())
  key       String   @unique @default("homepage")
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExchangeRateSnapshot {
  id            String   @id @default(cuid())
  baseCurrency  String // e.g. "USD"
  quoteCurrency String // e.g. "KES"
  rate          Decimal  @db.Decimal(14, 6)
  recordedAt    DateTime @default(now())

  @@index([baseCurrency, quoteCurrency, recordedAt])
}
